cat >> .gitignore <<'EOF'
# macOS
.DS_Store

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# .NET build
bin/
obj/
**/bin/
**/obj/
EOF
.DS_Store
**/bin/
**/obj/
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/build/
mobile/android/
mobile/ios/
*.env
mobile/.env
